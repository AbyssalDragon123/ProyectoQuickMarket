SET SERVEROUTPUT ON

PROMPT === Pre-chequeo: objetos que apuntan al tablespace ===
DECLARE
  v_cnt NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_cnt
  FROM dba_users
  WHERE default_tablespace = 'QUICKMARKET_TBS';
  DBMS_OUTPUT.PUT_LINE('Usuarios con DEFAULT_TABLESPACE=QUICKMARKET_TBS: '||v_cnt);

  SELECT COUNT(*) INTO v_cnt
  FROM dba_users
  WHERE temporary_tablespace = 'QUICKMARKET_TBS';
  DBMS_OUTPUT.PUT_LINE('Usuarios con TEMPORARY_TABLESPACE=QUICKMARKET_TBS: '||v_cnt);
END;
/

PROMPT === Paso 1: Mover cualquier usuario que tenga QUICKMARKET_TBS como DEFAULT ===
DECLARE
  CURSOR c IS
    SELECT username
    FROM dba_users
    WHERE default_tablespace = 'QUICKMARKET_TBS';
BEGIN
  FOR r IN c LOOP
    EXECUTE IMMEDIATE 'ALTER USER '||r.username||' DEFAULT TABLESPACE USERS';
    DBMS_OUTPUT.PUT_LINE('Cambiado DEFAULT_TABLESPACE de '||r.username||' a USERS');
  END LOOP;
END;
/

PROMPT === Paso 2: (Solo si alguien usa QUICKMARKET_TBS como TEMP) Mover a TEMP ===
DECLARE
  CURSOR c IS
    SELECT username
    FROM dba_users
    WHERE temporary_tablespace = 'QUICKMARKET_TBS';
BEGIN
  FOR r IN c LOOP
    EXECUTE IMMEDIATE 'ALTER USER '||r.username||' TEMPORARY TABLESPACE TEMP';
    DBMS_OUTPUT.PUT_LINE('Cambiado TEMPORARY_TABLESPACE de '||r.username||' a TEMP');
  END LOOP;
END;
/

PROMPT === Paso 3: Eliminar el esquema/usuario QUICKMARKET_USER (si existe) ===
DECLARE
  v_exists NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_exists
  FROM dba_users
  WHERE username = 'QUICKMARKET_USER';

  IF v_exists = 1 THEN
    EXECUTE IMMEDIATE 'DROP USER QUICKMARKET_USER CASCADE';
    DBMS_OUTPUT.PUT_LINE('Usuario QUICKMARKET_USER eliminado (CASCADE).');
  ELSE
    DBMS_OUTPUT.PUT_LINE('Usuario QUICKMARKET_USER no existe. Continuando...');
  END IF;
END;
/

PROMPT === Paso 4: Poner OFFLINE el tablespace (si existe) ===
DECLARE
  v_exists NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_exists
  FROM dba_tablespaces
  WHERE tablespace_name = 'QUICKMARKET_TBS';

  IF v_exists = 1 THEN
    BEGIN
      EXECUTE IMMEDIATE 'ALTER TABLESPACE QUICKMARKET_TBS OFFLINE';
      DBMS_OUTPUT.PUT_LINE('Tablespace QUICKMARKET_TBS puesto OFFLINE.');
    EXCEPTION
      WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Aviso: No se pudo poner OFFLINE (posible inactividad). Detalle: '||SQLERRM);
    END;
  ELSE
    DBMS_OUTPUT.PUT_LINE('Tablespace QUICKMARKET_TBS no existe. Continuando...');
  END IF;
END;
/

PROMPT === Paso 5: Eliminar tablespace QUICKMARKET_TBS incluyendo CONTENIDO y DATAFILES ===
DECLARE
  v_exists NUMBER;
BEGIN
  SELECT COUNT(*) INTO v_exists
  FROM dba_tablespaces
  WHERE tablespace_name = 'QUICKMARKET_TBS';

  IF v_exists = 1 THEN
    EXECUTE IMMEDIATE 'DROP TABLESPACE QUICKMARKET_TBS INCLUDING CONTENTS AND DATAFILES';
    DBMS_OUTPUT.PUT_LINE('Tablespace QUICKMARKET_TBS eliminado con DATAFILES.');
  ELSE
    DBMS_OUTPUT.PUT_LINE('Tablespace QUICKMARKET_TBS no existe (ya estaba eliminado).');
  END IF;
END;
/

