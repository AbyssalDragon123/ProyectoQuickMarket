-- codigo para crear usuario y tbs 
-- =====================================================================
-- RECREAR ENTORNO QUICKMARKET DESDE CERO
-- Ejecutar como SYSDBA (en la PDB correcta si aplica)
-- =====================================================================

-- 1) TABLESPACE
CREATE TABLESPACE QUICKMARKET_TBS
  DATAFILE 'quickmarket01.dbf'
  SIZE 50M
  AUTOEXTEND ON NEXT 10M
  MAXSIZE UNLIMITED;

-- 2) USUARIO
CREATE USER QUICKMARKET_USER IDENTIFIED BY QuickMkt#2025
  DEFAULT TABLESPACE QUICKMARKET_TBS
  TEMPORARY TABLESPACE TEMP
  QUOTA UNLIMITED ON QUICKMARKET_TBS;

-- Permisos básicos
GRANT CONNECT, RESOURCE TO QUICKMARKET_USER;

-- 3) Cambiar al esquema
ALTER SESSION SET CURRENT_SCHEMA = QUICKMARKET_USER;


SELECT username, default_tablespace FROM dba_users WHERE username='QUICKMARKET_USER';
SELECT tablespace_name, status FROM dba_tablespaces WHERE tablespace_name='QUICKMARKET_TBS';
SELECT file_name FROM dba_data_files WHERE tablespace_name='QUICKMARKET_TBS';
