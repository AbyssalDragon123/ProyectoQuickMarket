--------------------------------------------------------------------------------
-- QUICKMARKET - Esquema base (tablas + índices) -> Triggers
--------------------------------------------------------------------------------

-- 4.1 EMPLEADOS
CREATE TABLE EMPLEADOS (
  ID_EMPLEADO     NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  NOMBRE          VARCHAR2(80)   NOT NULL,
  CARNET          VARCHAR2(30)   NOT NULL,
  CREADO_EN       TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN  TIMESTAMP,
  CONSTRAINT UQ_EMPLEADOS_CARNET UNIQUE (CARNET),
  CONSTRAINT UQ_EMPLEADO_CARNET  UNIQUE (NOMBRE, CARNET)
) TABLESPACE QUICKMARKET_TBS;

-- 4.2 CLIENTES
CREATE TABLE CLIENTES (
  ID_CLIENTE     NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  ID_EMPLEADO    NUMBER,
  NOMBRE         VARCHAR2(150) NOT NULL,
  EMAIL          VARCHAR2(150),
  TELEFONO       VARCHAR2(30),
  DIRECCION      VARCHAR2(200),
  DEPARTAMENTO   VARCHAR2(80),
  MUNICIPIO      VARCHAR2(80),
  REFERENCIA     VARCHAR2(200),
  CREADO_EN      TIMESTAMP     DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN TIMESTAMP,
  CONSTRAINT UQ_CLIENTES_EMAIL UNIQUE (EMAIL),
  CONSTRAINT FK_CLIENTE_EMPLEADO
    FOREIGN KEY (ID_EMPLEADO) REFERENCES EMPLEADOS(ID_EMPLEADO)
    ON DELETE SET NULL
) TABLESPACE QUICKMARKET_TBS;

CREATE INDEX IX_CLIENTES_EMPLEADOS ON CLIENTES(ID_EMPLEADO);

-- 4.3 CATEGORIAS
CREATE TABLE CATEGORIAS (
  ID_CATEGORIA   NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  NOMBRE         VARCHAR2(100) NOT NULL,
  DESCRIPCION    VARCHAR2(255),
  CREADO_EN      TIMESTAMP     DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN TIMESTAMP
) TABLESPACE QUICKMARKET_TBS;

-- 4.4 PRODUCTOS (precio sin IVA; columnas virtuales de IVA)
CREATE TABLE PRODUCTOS (
  ID_PRODUCTO       NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  NOMBRE            VARCHAR2(120)  NOT NULL,
  DESCRIPCION       VARCHAR2(120)  NOT NULL,
  PRECIO_UNITARIO   NUMBER(12,2)   NOT NULL,
  STOCK             NUMBER(12,3)   DEFAULT 0 NOT NULL,
  ID_CATEGORIA      NUMBER,
  IVA_UNITARIO      GENERATED ALWAYS AS (ROUND(PRECIO_UNITARIO * 0.12, 2)) VIRTUAL,
  PRECIO_CON_IVA    GENERATED ALWAYS AS (PRECIO_UNITARIO + ROUND(PRECIO_UNITARIO * 0.12, 2)) VIRTUAL,
  CREADO_EN         TIMESTAMP      DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN    TIMESTAMP,
  CONSTRAINT FK_PRODUCTO_CATEGORIA
    FOREIGN KEY (ID_CATEGORIA) REFERENCES CATEGORIAS(ID_CATEGORIA)
    ON DELETE SET NULL,
  CONSTRAINT CHK_PRECIO_POSITIVO CHECK (PRECIO_UNITARIO >= 0),
  CONSTRAINT CHK_STOCK_NO_NEG    CHECK (STOCK >= 0)
) TABLESPACE QUICKMARKET_TBS;

CREATE INDEX IX_PRODUCTOS_CATEGORIA ON PRODUCTOS(ID_CATEGORIA);
CREATE INDEX IX_PRODUCTOS_NOMBRE    ON PRODUCTOS(NOMBRE);

-- 4.5 VENTAS (totales se recalculan vía trigger)
CREATE TABLE VENTAS (
  ID_VENTA          NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  FECHA             DATE DEFAULT SYSDATE NOT NULL,
  ID_CLIENTE        NUMBER,
  TOTAL_BRUTO       NUMBER(12,2) DEFAULT 0 NOT NULL,
  TOTAL_IMPUESTOS   NUMBER(12,2) DEFAULT 0 NOT NULL,
  TOTAL_NETO        NUMBER(12,2) DEFAULT 0 NOT NULL,
  ID_EMPLEADO       NUMBER,
  CREADO_EN         TIMESTAMP  DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN    TIMESTAMP,
  CONSTRAINT FK_VENTA_CLIENTE
    FOREIGN KEY (ID_CLIENTE) REFERENCES CLIENTES(ID_CLIENTE)
    ON DELETE SET NULL,
  CONSTRAINT FK_VENTA_EMPLEADO
    FOREIGN KEY (ID_EMPLEADO) REFERENCES EMPLEADOS(ID_EMPLEADO)
    ON DELETE SET NULL,
  CONSTRAINT CHK_TOTALES_NO_NEG CHECK (TOTAL_BRUTO >= 0 AND TOTAL_IMPUESTOS >= 0 AND TOTAL_NETO >= 0),
  CONSTRAINT CHK_TOTALES_CONSISTENTES CHECK (TOTAL_NETO = TOTAL_BRUTO + TOTAL_IMPUESTOS)
) TABLESPACE QUICKMARKET_TBS;

CREATE INDEX IX_VENTAS_CLIENTE  ON VENTAS(ID_CLIENTE);
CREATE INDEX IX_VENTAS_EMPLEADO ON VENTAS(ID_EMPLEADO);

-- 4.6 DETALLE_VENTAS
CREATE TABLE DETALLE_VENTAS (
  ID_DETALLE        NUMBER GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  ID_VENTA          NUMBER NOT NULL,
  ID_PRODUCTO       NUMBER NOT NULL,
  CANTIDAD          NUMBER(12,3) NOT NULL,
  PRECIO_UNITARIO   NUMBER(12,2) NOT NULL,
  SUBTOTAL          GENERATED ALWAYS AS (CANTIDAD * PRECIO_UNITARIO) VIRTUAL,
  CREADO_EN         TIMESTAMP     DEFAULT SYSTIMESTAMP NOT NULL,
  ACTUALIZADO_EN    TIMESTAMP,
  CONSTRAINT FK_DET_VENTA
    FOREIGN KEY (ID_VENTA) REFERENCES VENTAS(ID_VENTA)
    ON DELETE CASCADE,
  CONSTRAINT FK_DET_PRODUCTO
    FOREIGN KEY (ID_PRODUCTO) REFERENCES PRODUCTOS(ID_PRODUCTO),
  CONSTRAINT CHK_DET_CANT_POS CHECK (CANTIDAD > 0),
  CONSTRAINT CHK_DET_PREC_POS CHECK (PRECIO_UNITARIO >= 0),
  CONSTRAINT UQ_DET_VENTA_PRODUCTO UNIQUE (ID_VENTA, ID_PRODUCTO)
) TABLESPACE QUICKMARKET_TBS;

CREATE INDEX IX_DETALLE_VENTAS_VENTA    ON DETALLE_VENTAS(ID_VENTA);
CREATE INDEX IX_DETALLE_VENTAS_PRODUCTO ON DETALLE_VENTAS(ID_PRODUCTO);

--------------------------------------------------------------------------------
-- TRIGGERS
--------------------------------------------------------------------------------

-- TIMESTAMP: actualiza ACTUALIZADO_EN en cada UPDATE
CREATE OR REPLACE TRIGGER TRG_TS_EMPLEADOS
BEFORE UPDATE ON EMPLEADOS
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_TS_CLIENTES
BEFORE UPDATE ON CLIENTES
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_TS_CATEGORIAS
BEFORE UPDATE ON CATEGORIAS
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_TS_PRODUCTOS
BEFORE UPDATE ON PRODUCTOS
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_TS_VENTAS
BEFORE UPDATE ON VENTAS
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

CREATE OR REPLACE TRIGGER TRG_TS_DETALLE_VENTAS
BEFORE UPDATE ON DETALLE_VENTAS
FOR EACH ROW
BEGIN
  :NEW.ACTUALIZADO_EN := SYSTIMESTAMP;
END;
/

-- NEGOCIO: control de stock y recálculo de totales (IVA 12%)

-- A) Antes de INSERT/UPDATE en detalle: validar y ajustar stock
CREATE OR REPLACE TRIGGER TRG_DETALLE_STOCK_BI
BEFORE INSERT OR UPDATE OF CANTIDAD, PRECIO_UNITARIO ON DETALLE_VENTAS
FOR EACH ROW
DECLARE
  v_stock NUMBER;
BEGIN
  SELECT STOCK INTO v_stock
    FROM PRODUCTOS
   WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO
   FOR UPDATE;

  IF INSERTING THEN
    IF :NEW.CANTIDAD <= 0 THEN
      RAISE_APPLICATION_ERROR(-20001, 'Cantidad debe ser > 0');
    END IF;
    IF v_stock < :NEW.CANTIDAD THEN
      RAISE_APPLICATION_ERROR(-20002, 'Stock insuficiente');
    END IF;
    UPDATE PRODUCTOS
       SET STOCK = STOCK - :NEW.CANTIDAD
     WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO;

  ELSIF UPDATING THEN
    UPDATE PRODUCTOS
       SET STOCK = STOCK + :OLD.CANTIDAD - :NEW.CANTIDAD
     WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO;

    SELECT STOCK INTO v_stock FROM PRODUCTOS WHERE ID_PRODUCTO = :NEW.ID_PRODUCTO;
    IF v_stock < 0 THEN
      RAISE_APPLICATION_ERROR(-20002, 'Stock insuficiente al actualizar');
    END IF;
  END IF;
END;
/

-- B) Después de DELETE en detalle: reponer stock
CREATE OR REPLACE TRIGGER TRG_DETALLE_STOCK_AD
AFTER DELETE ON DETALLE_VENTAS
FOR EACH ROW
BEGIN
  UPDATE PRODUCTOS
     SET STOCK = STOCK + :OLD.CANTIDAD
   WHERE ID_PRODUCTO = :OLD.ID_PRODUCTO;
END;
/

-- C) Compound trigger: recalcular totales de la venta (IVA 12%) al cambiar detalles
CREATE OR REPLACE TRIGGER TRG_VENTAS_RECALC
FOR INSERT OR UPDATE OR DELETE ON DETALLE_VENTAS
COMPOUND TRIGGER

  TYPE t_ids IS TABLE OF NUMBER INDEX BY PLS_INTEGER;
  g_ids t_ids;  -- ventas afectadas en esta sentencia

  PROCEDURE add_id(p_id NUMBER) IS
  BEGIN
    IF p_id IS NOT NULL THEN
      FOR i IN 1 .. g_ids.COUNT LOOP
        IF g_ids(i) = p_id THEN
          RETURN; -- ya agregado
        END IF;
      END LOOP;
      g_ids(g_ids.COUNT + 1) := p_id;
    END IF;
  END;

  AFTER EACH ROW IS
  BEGIN
    IF INSERTING OR UPDATING THEN
      add_id(:NEW.ID_VENTA);
    ELSIF DELETING THEN
      add_id(:OLD.ID_VENTA);
    END IF;
  END AFTER EACH ROW;

  AFTER STATEMENT IS
    v_tasa CONSTANT NUMBER := 0.12;
  BEGIN
    FOR i IN 1 .. g_ids.COUNT LOOP
      UPDATE VENTAS v
         SET (TOTAL_BRUTO, TOTAL_IMPUESTOS, TOTAL_NETO) = (
               SELECT NVL(SUM(d.SUBTOTAL), 0),
                      ROUND(NVL(SUM(d.SUBTOTAL), 0) * v_tasa, 2),
                      NVL(SUM(d.SUBTOTAL), 0) + ROUND(NVL(SUM(d.SUBTOTAL), 0) * v_tasa, 2)
                 FROM DETALLE_VENTAS d
                WHERE d.ID_VENTA = v.ID_VENTA
             )
       WHERE v.ID_VENTA = g_ids(i);
    END LOOP;
  END AFTER STATEMENT;

END TRG_VENTAS_RECALC;
/
