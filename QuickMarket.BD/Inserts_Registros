-------------------------------------------------------------------------------
-- (Opcional) SELECTs rápidos de verificación
-------------------------------------------------------------------------------
-- EMPLEADOS
SELECT ID_EMPLEADO, EMPLEADO, CARNET FROM EMPLEADOS ORDER BY ID_EMPLEADO;

-- CATEGORIAS
SELECT ID_CATEGORIA, NOMBRE FROM CATEGORIAS ORDER BY ID_CATEGORIA;

-- PRODUCTOS
SELECT ID_PRODUCTO, NOMBRE, PRECIO_UNITARIO, STOCK
FROM PRODUCTOS
ORDER BY ID_PRODUCTO;

-- CLIENTES (con asesor)
SELECT c.ID_CLIENTE, c.NOMBRE, e.EMPLEADO AS ASESOR
FROM CLIENTES c LEFT JOIN EMPLEADOS e ON e.ID_EMPLEADO = c.ID_EMPLEADO
ORDER BY c.ID_CLIENTE;

-- VENTAS (con cliente y empleado)
SELECT v.ID_VENTA, v.FECHA, c.NOMBRE AS CLIENTE, e.EMPLEADO AS VENDEDOR,
       v.TOTAL_BRUTO, v.TOTAL_IMPUESTOS, v.TOTAL_NETO
FROM VENTAS v
LEFT JOIN CLIENTES c  ON c.ID_CLIENTE  = v.ID_CLIENTE
LEFT JOIN EMPLEADOS e ON e.ID_EMPLEADO = v.ID_EMPLEADO
ORDER BY v.ID_VENTA;

-- DETALLE_VENTAS (con producto)
SELECT d.ID_DETALLE, d.ID_VENTA, p.NOMBRE AS PRODUCTO, d.CANTIDAD, d.PRECIO_UNITARIO, d.SUBTOTAL
FROM DETALLE_VENTAS d
JOIN PRODUCTOS p ON p.ID_PRODUCTO = d.ID_PRODUCTO
ORDER BY d.ID_DETALLE;
