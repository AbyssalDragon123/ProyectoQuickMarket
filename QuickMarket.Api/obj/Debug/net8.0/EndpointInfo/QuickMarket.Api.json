            "type": "number",
            "format": "double"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "creadoEn": {
            "type": "string",
            "format": "date-time"
          },
          "actualizadoEn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CategoriaUpdateDto": {
        "required": [
