            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "telefono": {
            "type": "string",
            "nullable": true
          },
          "direccion": {
            "type": "string",
            "nullable": true
          },
          "departamento": {
            "type": "string",
            "nullable": true
          },
          "municipio": {
            "type": "string",
            "nullable": true
          },
          "referencia": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClienteUpsertDto": {
        "required": [
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 150,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "telefono": {
            "pattern": "^[0-9\\s\\-\\+\\(\\)]{7,20}$",
            "type": "string",
            "nullable": true
          },
          "direccion": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          },
          "departamento": {
            "maxLength": 80,
            "type": "string",
            "nullable": true
          },
