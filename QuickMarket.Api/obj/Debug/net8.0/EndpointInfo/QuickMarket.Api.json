        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 120,
            "minLength": 2,
            "type": "string"
          },
          "descripcion": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "nullable": true
          }
        },
