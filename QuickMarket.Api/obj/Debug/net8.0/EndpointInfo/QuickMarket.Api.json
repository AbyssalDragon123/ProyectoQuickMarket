            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ClienteDto": {
        "type": "object",
        "properties": {
          "idCliente": {
            "type": "number",
            "format": "double"
          },
          "idUsuario": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
